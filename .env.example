ASPNETCORE_ENVIRONMENT=Docker
# Container próprio do back-office (docker-compose.yml, gvenzl/oracle-free): o
# service name é FREEPDB1, não XEPDB1 — esse é o da imagem oracle-xe.
ConnectionStrings__Oracle=Data Source=(DESCRIPTION=(ADDRESS_LIST=(ADDRESS=(PROTOCOL=TCP)(HOST=localhost)(PORT=1522)))(CONNECT_DATA=(SERVER=DEDICATED)(SERVICE_NAME=FREEPDB1)));User Id=PETBUDDIES;Password=petbuddies;Max Pool Size=3;Min Pool Size=1
MotorApi__BaseUrl=http://petbuddies-java:8080
# Segredo compartilhado do JWT (ADR s3-20): HS256, mesmo valor no Java e no .NET,
# minimo de 32 caracteres. NUNCA versionar o valor real — este arquivo e so o molde.
PETBUDDIES_JWT_SECRET=troque-por-um-segredo-de-no-minimo-32-caracteres
